{
  "name": "470-collins-available-spaces",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets:convert": "node scripts/convert-sequence-sources-to-webp.mjs",
    "assets": "node scripts/build-sequence-assets.mjs",
    "dev": "vite",
    "build": "npm run assets && tsc -b && vite build",
    "lint": "tsc -b --pretty false && eslint scripts/*.mjs eslint.config.js",
    "test": "vitest run",
    "stress:viewer": "node scripts/stress-viewer.mjs",
    "stress:masks": "node scripts/stress-floor-interaction.mjs",
    "stress:units": "node scripts/stress-unit-flow.mjs",
    "preview": "vite preview",
    "stress:loading": "node scripts/stress-sequence-loading.mjs",
    "stress:hero": "node scripts/stress-hero-video.mjs",
    "stress:hero:bounds": "node scripts/stress-hero-boundaries.mjs"
